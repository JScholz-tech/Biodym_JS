     "text": [
      "--> Exporting results to 'data/02_output/results_scientific.xlsx'...\n",
      "✅ Results exported to: data/02_output/results_scientific.xlsx\n"
     ]
    }
   ],
   "source": [
    "# Export to Excel\n",
    "output_file = \"data/02_output/results_scientific.xlsx\"\n",
    "try:\n",
    "    utils.export_results_to_excel(mfa_system_with_results, output_file)\n",
    "    print(f\"✅ Results exported to: {output_file}\")\n",
    "except Exception as e:\n",
    "    print(f\"⚠️ Export error: {e}\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "f3030588",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "✅ Configuration exported to: data/02_output/results_scientific_config.xlsx\n"
     ]
    }
   ],
   "source": [
    "# Export configuration summary\n",
    "config_file = output_file.replace('.xlsx', '_config.xlsx')\n",
    "try:\n",
    "    config_summary = pd.DataFrame([{\n",
    "        'Input File': input_file,\n",
    "        'Start Year': start_year,\n",
    "        'End Year': end_year,\n",
    "        'Elements': ', '.join(elements),\n",
    "        'Monte Carlo': has_mc,\n",
    "        'DSM': has_dsm,\n",
    "        'FOMP': has_fomp\n",
    "    }])\n",
    "    config_summary.to_excel(config_file, index=False)\n",
    "    print(f\"✅ Configuration exported to: {config_file}\")\n",
    "except Exception as e:\n",
    "    print(f\"⚠️ Config export error: {e}\")"
   ]
  },
