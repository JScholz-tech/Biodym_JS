   "id": "a99dd768",
   "metadata": {},
   "outputs": [],
   "source": [
    "# Add ODYM framework to path\n",
    "biodym_mfa_tool_dir = os.getcwd()\n",
    "odym_path = os.path.join(\n",
    "    biodym_mfa_tool_dir, \"framework\", \"ODYM-master_20241127\", \"odym\", \"modules\"\n",
    ")\n",
    "sys.path.insert(0, odym_path)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "b75ad7e7",
   "metadata": {},
   "outputs": [],
   "source": [
    "# Add bioDYM add-on to path\n",
