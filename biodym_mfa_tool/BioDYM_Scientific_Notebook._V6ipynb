      "============================================================\n"
     ]
    }
   ],
   "source": [
    "print(\"\\n\" + \"=\"*60)\n",
    "print(\"⚖️ MASS BALANCE VERIFICATION\")\n",
    "print(\"=\"*60)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "17af190a",
   "metadata": {},
   "outputs": [],
   "source": [
    "# Calculate mass balance errors\n",
    "mass_balance_errors = []\n",
    "for process in mfa_system_with_results.ProcessList:\n",
    "    if hasattr(process, 'MassBalance') and process.MassBalance is not None:\n",
    "        for year_idx, year in enumerate(range(start_year, end_year + 1)):\n",
    "            for element_idx, element in enumerate(elements):\n",
    "                error = process.MassBalance[year_idx, element_idx]\n",
    "                if abs(error) > 1e-6:  # Significant error threshold\n",
    "                    mass_balance_errors.append({\n",
    "                        'Process': process.Name,\n",
    "                        'Year': year,\n",
    "                        'Element': element,\n",
    "                        'Error': error\n",
    "                    })"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "fe2ef506",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "✅ All mass balances within acceptable limits\n"
     ]
    }
   ],
   "source": [
    "if mass_balance_errors:\n",
    "    print(\"⚠️ Mass balance errors detected:\")\n",
    "    error_df = pd.DataFrame(mass_balance_errors)\n",
    "    display(error_df)\n",
    "else:\n",
    "    print(\"✅ All mass balances within acceptable limits\")"
   ]
  },
