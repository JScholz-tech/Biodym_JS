# =============================================================================
# BioDYM .gitignore - Clean Repository for Publication
# =============================================================================

# -----------------------------------------------------------------------------
# Python
# -----------------------------------------------------------------------------
__pycache__/
*.pyc
*.pyo
*.pyd
*$py.class
.pytest_cache/
.ruff_cache/

# -----------------------------------------------------------------------------
# Virtual Environments
# -----------------------------------------------------------------------------
.env
.venv
env/
venv/

# -----------------------------------------------------------------------------
# IDE / Editor
# -----------------------------------------------------------------------------
.vscode/
.idea/
.project
.classpath
# Track project skills and CLAUDE.md but exclude local/personal settings
.claude/settings.local.json
.claude/settings.json

# -----------------------------------------------------------------------------
# Jupyter Notebooks
# -----------------------------------------------------------------------------
.ipynb_checkpoints/

# -----------------------------------------------------------------------------
# Temporary Files (Windows/Office/Editor)
# -----------------------------------------------------------------------------
~$*.xlsx
~$*.xlsm
~$*.xltm
~$*.docx
~$*.pptx
*.tmp
*.bak
*.swp
*~
nul
*.dtmp
.$*

# -----------------------------------------------------------------------------
# Backup and Conflict Files
# -----------------------------------------------------------------------------
*_backup_*.py
*_conflict_backup.py
*(restored)*
*(*conflicted copy*).*
*(*Conflicted copy*).*

# -----------------------------------------------------------------------------
# Root Level - Misc generated files
# -----------------------------------------------------------------------------
# MFA output files dumped at root during exploration
mfa-*.xlsx

# -----------------------------------------------------------------------------
# Root Level - Excluded Directories
# -----------------------------------------------------------------------------
# Archive and old duplicates
Archive/
basic_examples/
docs/

# AI assistance (development notes, not for publication)
07_AI_Coding_Assistance/

# Scenario outputs (generated files, stored in 01_data/02_output/scenarios/)
scenarios/

# -----------------------------------------------------------------------------
# 04_tests - Generated artifacts and dev scripts
# -----------------------------------------------------------------------------
# Scenario files generated by test runs (not fixtures)
04_tests/scenarios/

# Development/debugging script (not a pytest test)
04_tests/sankey_validation_script.py

# Writing project (private publication materials)
Writing project/

# Web app case studies (user data, not tracked)
# Moved from root case_studies/ → 01_data/01_input/case_studies/
case_studies/

# -----------------------------------------------------------------------------
# Claude Code / tool session artifacts
# -----------------------------------------------------------------------------
.agents/
__marimo__/
*/__marimo__/
server.log
skills-lock.json

# Python build artifacts
*.egg-info/

# -----------------------------------------------------------------------------
# 01_data - Input Files (only template is tracked)
# -----------------------------------------------------------------------------
# Exclude everything in input folder except the template subfolder
01_data/01_input/*
!01_data/01_input/template/
!01_data/01_input/template/**

# Temporary hex-named lock files
01_data/01_input/[0-9A-F][0-9A-F][0-9A-F][0-9A-F][0-9A-F][0-9A-F][0-9A-F][0-9A-F]

# -----------------------------------------------------------------------------
# 01_data - Output Files (all generated, not tracked)
# -----------------------------------------------------------------------------
# Ignore all output files, but keep folder structure via .gitkeep
01_data/02_output/**
!01_data/02_output/**/
!01_data/02_output/**/.gitkeep

# -----------------------------------------------------------------------------
# 05_docs - Development / Internal files (kept locally, not for publication)
# -----------------------------------------------------------------------------
# All internal development files moved here by user
05_docs/internal_developement/

# Archive: all superseded design originals and development history
05_docs/_archive/

# AI coding assistant instructions (Claude-specific, stale, not for public)
05_docs/development/CLAUDE.md

# ODYM compliance refactoring history (internal development artifacts)
05_docs/development/odym-compliance/

# Future/internal roadmap documents
05_docs/development/6D_INTEGRATION_ROADMAP.md
05_docs/development/SORTING_PLANT_EXTENSION_OVERVIEW.md

# Miscellaneous files unrelated to BioDYM
05_docs/feedback_10124.xml
05_docs/recommended_positions_CE-RISE.csv
05_docs/recommended_positions_ODYM1.csv

# Generated LaTeX compile log
05_docs/manual/biodym_manual.log

# -----------------------------------------------------------------------------
# 03_studies - Case Studies
# -----------------------------------------------------------------------------
# Ignore all studies except the published Weizenstroh DGAW study
03_studies/*/
03_studies/*.*
!03_studies/26_Weizenstroh_DGAW/
!03_studies/26_Weizenstroh_DGAW/**